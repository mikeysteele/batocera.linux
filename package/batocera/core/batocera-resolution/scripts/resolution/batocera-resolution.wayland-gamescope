#!/bin/sh
# batocera-resolution for wayland/gamescope
# Gamescope manages DRM directly (no wlr-output-management / wlr-randr).
# Output and mode queries use /sys/class/drm, modetest, and /var/run/gamescope.mode.

LOG="/userdata/system/logs/display.log"
BOOTCONF="/boot/batocera-boot.conf"
MODE_FILE="/var/run/gamescope.mode"
OUTPUT_FILE="/var/run/gamescope.output"

_log() {
    mkdir -p "$(dirname "${LOG}")" 2>/dev/null
    printf "%s - %s\n" "$(date '+%F %T')" "$*" >> "${LOG}" 2>/dev/null
}

f_usage() {
    echo "$0 --screen SCREEN ACTION" >&2
    echo "$0 listModes" >&2
    echo "$0 setMode MODE" >&2
    echo "$0 currentMode" >&2
    echo "$0 currentResolution" >&2
    echo "$0 listOutputs" >&2
    echo "$0 currentOutput" >&2
    echo "$0 setOutput OUTPUT [OUTPUT2 ...]" >&2
    echo "$0 minTomaxResolution" >&2
    echo "$0 minTomaxResolution-secure" >&2
    echo "$0 setRotation (0|1|2|3)" >&2
    echo "$0 getRotation" >&2
    echo "$0 supportSystemRotation" >&2
    echo "$0 supportSystemReflection" >&2
    echo "$0 getDisplayMode" >&2
    echo "$0 getDisplayComp" >&2
    echo "$0 refreshRate" >&2
    echo "$0 outputModel" >&2
    echo "$0 supportHdr" >&2
    echo "$0 setHdr" >&2
    echo "$0 supportVrr" >&2
    echo "$0 setVrr" >&2
    echo "$0 repositionOutputs" >&2
    echo "$0 configureWindow" >&2
}

_find_drm_driver() {
    for d in /sys/class/drm/card[0-9]/device/driver; do
        if [ -e "${d}" ]; then
            basename "$(readlink -f "${d}")"
            return 0
        fi
    done
    return 1
}

_find_drm_card() {
    for c in /sys/class/drm/card[0-9]; do
        if [ -d "${c}" ]; then
            basename "${c}"
            return 0
        fi
    done
    return 1
}

_list_connected_outputs() {
    for status_file in /sys/class/drm/card[0-9]-*/status; do
        [ -f "${status_file}" ] || continue
        if [ "$(cat "${status_file}" 2>/dev/null)" = "connected" ]; then
            conn_dir=$(dirname "${status_file}")
            conn_name=$(basename "${conn_dir}")
            # Strip leading cardX-
            echo "${conn_name#card[0-9]-}"
        fi
    done
}

_detect_primary_screen() {
    if [ -f "${OUTPUT_FILE}" ]; then
        saved=$(head -n1 "${OUTPUT_FILE}" 2>/dev/null)
        if [ -n "${saved}" ] && _list_connected_outputs | grep -qx "${saved}"; then
            echo "${saved}"
            return 0
        fi
    fi

    cfg_out=$(batocera-settings-get-master global.videooutput 2>/dev/null)
    if [ -n "${cfg_out}" ] && _list_connected_outputs | grep -qx "${cfg_out}"; then
        echo "${cfg_out}"
        return 0
    fi

    _list_connected_outputs | head -n1
}

_hz_to_mhz() {
    awk -v hz="$1" 'BEGIN { printf "%.0f\n", hz * 1000 }'
}

# modes a sink only takes as YCbCr 4:2:0 sit in the EDID's Y420 video data block; TVs tend to show
# no picture on them, so they are left out of every listing
_420_only_modes() {
    local edid
    edid=$(ls /sys/class/drm/card*-"$1"/edid 2>/dev/null | head -n1)
    [ -n "${edid}" ] || return 0
    edid-decode "${edid}" 2>/dev/null | sed -n '/YCbCr 4:2:0 Video Data Block/,/^  [^ ]/p' | awk '/VIC/ { printf "%s@%.0f\n", $3, $4 }'
}

# List available modes for connector via modetest -> WxH@Hz.000Hz lines
_get_drm_modes() {
    local out="$1"
    local driver skip
    driver=$(_find_drm_driver)
    [ -n "${driver}" ] || return 1
    skip=$(_420_only_modes "${out}" | tr '\n' ' ')
    modetest -M "${driver}" -c 2>/dev/null | awk -v target="${out}" -v skip=" ${skip} " '
        /^[0-9]+\t/ { in_target = ($4 == target && $3 == "connected") }
        in_target && /^  #[0-9]+ [0-9]+x[0-9]+/ {
            if ($0 ~ /flags:.*interlace/) next
            res = $2
            hz = $3
            if (index(skip, " " res "@" int(hz + 0.5) " ")) next
            printf "%s@%.3fHz\n", res, hz + 0
        }
    ' | sort -u | sort -Vr
}

# Preferred mode for connector from modetest (prefer ~60Hz at preferred resolution)
_get_preferred_drm_mode() {
    local out="$1"
    local driver pref_res
    driver=$(_find_drm_driver)
    [ -n "${driver}" ] || return 1
    pref_res=$(modetest -M "${driver}" -c 2>/dev/null | awk -v target="${out}" '
        /^[0-9]+\t/ { in_target = ($4 == target && $3 == "connected") }
        in_target && /^  #[0-9]+ [0-9]+x[0-9]+/ && /type:.*preferred/ {
            print $2
            exit
        }
    ')
    _get_drm_modes "${out}" | awk -F'[@H]' -v res="${pref_res}" '
        {
            hz = $2 + 0
            split($1, wh, "x")
            d = hz - 60; if (d < 0) d = -d
            score = (d <= 1) * 1e15 + ($1 == res) * 1e14 + wh[1] * wh[2] * 1e3 + 1000 - d * 10
            if (best == "" || score > bs) { best = $0; bs = score }
        }
        END { print best }'
}

# Active CRTC mode from modetest (if any)
_get_active_crtc_mode() {
    local out="${1:-${PSCREEN}}"
    local driver
    driver=$(_find_drm_driver)
    [ -n "${driver}" ] || return 1
    modetest -M "${driver}" -e -c -p 2>/dev/null | awk -v target="${out}" '
        /^Encoders:/ { sec = "enc"; next }
        /^Connectors:/ { sec = "conn"; next }
        /^CRTCs:/ { sec = "crtc"; next }
        /^[A-Za-z]/ { sec = ""; next }
        sec == "enc" && /^[0-9]+\t/ { enc_crtc[$1] = $2 }
        sec == "conn" && /^[0-9]+\t/ {
            if ($4 == target && $3 == "connected") {
                target_enc = $2
            }
        }
        sec == "crtc" && /^[0-9]+\t/ {
            want_crtc = (target_enc != "" && target_enc in enc_crtc) ? enc_crtc[target_enc] : ""
            in_crtc = ($2 != "0" && (want_crtc == "" || $1 == want_crtc))
        }
        sec == "crtc" && in_crtc && /^  #[0-9]+ [0-9]+x[0-9]+/ {
            printf "%s@%.3fHz\n", $2, $3 + 0
            exit
        }
    '
}

_get_current_mode_string() {
    local out="$1"
    local m
    if [ -f "${MODE_FILE}" ]; then
        m=$(head -n1 "${MODE_FILE}" 2>/dev/null)
        if [ -n "${m}" ]; then
            echo "${m}"
            return 0
        fi
    fi
    m=$(_get_active_crtc_mode "${out}")
    if [ -n "${m}" ]; then
        echo "${m}"
        return 0
    fi
    m=$(_get_preferred_drm_mode "${out}")
    if [ -n "${m}" ]; then
        echo "${m}"
        return 0
    fi
    # Fallback via sysfs modes
    for mf in /sys/class/drm/card[0-9]-"${out}"/modes; do
        if [ -f "${mf}" ]; then
            res=$(head -n1 "${mf}" 2>/dev/null)
            if [ -n "${res}" ]; then
                echo "${res}@60.000Hz"
                return 0
            fi
        fi
    done
    echo "1920x1080@60.000Hz"
}

_apply_gamescope_mode() {
    local mode="$1"
    local cur res w h hz mhz
    [ -n "${mode}" ] || return 1
    if [ -f "${MODE_FILE}" ]; then
        cur=$(head -n1 "${MODE_FILE}" 2>/dev/null)
        if [ "${cur}" = "${mode}" ]; then
            return 0
        fi
    fi
    echo "${mode}" > "${MODE_FILE}"
    res=$(echo "${mode}" | cut -d'@' -f1)
    w=$(echo "${res}" | cut -dx -f1)
    h=$(echo "${res}" | cut -dx -f2)
    hz=$(echo "${mode}" | sed -n 's/.*@\([0-9.]*\)Hz/\1/p')
    if [ -n "${hz}" ]; then
        mhz=$(_hz_to_mhz "${hz}")
    else
        mhz=60000
    fi
    if echo "${w}" | grep -qE '^[0-9]+$' && echo "${h}" | grep -qE '^[0-9]+$'; then
        if command -v xprop >/dev/null 2>&1; then
            DISPLAY="${DISPLAY:-:0}" xprop -root -format GAMESCOPE_XWAYLAND_MODE_CONTROL 32c \
                -set GAMESCOPE_XWAYLAND_MODE_CONTROL "0, ${w}, ${h}, ${mhz}" 2>/dev/null || true
        elif command -v python3 >/dev/null 2>&1; then
            DISPLAY="${DISPLAY:-:0}" python3 -c "
import ctypes, os
x11 = ctypes.CDLL('libX11.so.6')
x11.XOpenDisplay.restype = ctypes.c_void_p
x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
x11.XDefaultRootWindow.restype = ctypes.c_ulong
x11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
x11.XInternAtom.restype = ctypes.c_ulong
x11.XChangeProperty.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_void_p, ctypes.c_int]
x11.XFlush.argtypes = [ctypes.c_void_p]
dpy = x11.XOpenDisplay(os.environ.get('DISPLAY', ':0').encode())
if dpy:
    root = x11.XDefaultRootWindow(dpy)
    atom = x11.XInternAtom(dpy, b'GAMESCOPE_XWAYLAND_MODE_CONTROL', 0)
    card = x11.XInternAtom(dpy, b'CARDINAL', 0)
    data = (ctypes.c_ulong * 4)(0, ${w}, ${h}, ${mhz})
    x11.XChangeProperty(dpy, root, atom, card, 32, 0, data, 4)
    x11.XFlush(dpy)
" 2>/dev/null || true
        fi
    fi
}

_hdr_capable() {
    local out
    out=$(_detect_primary_screen)
    [ -n "${out}" ] || return 1
    edid=$(ls /sys/class/drm/card*-"${out}"/edid 2>/dev/null | head -n1)
    [ -n "${edid}" ] || return 1
    edid-decode "${edid}" 2>/dev/null | grep -q "HDR Static Metadata Data Block"
}

_vrr_capable() {
    local out driver
    out=$(_detect_primary_screen)
    driver=$(_find_drm_driver)
    [ -n "${out}" ] && [ -n "${driver}" ] || return 1
    modetest -M "${driver}" -c 2>/dev/null | awk -v target="${out}" '
        /^[0-9]+\t/ { in_target = ($4 == target && $3 == "connected") }
        in_target && /vrr_capable:/ { found = 1 }
        in_target && found && /value: 1/ { ok = 1; exit }
        in_target && found && /name:/ && !/vrr_capable/ { found = 0 }
        END { exit !ok }
    '
}

f_minTomaxResolution() {
    local max_res="$1"
    local max_w max_h max_pixels cur_mode cur_res cur_w cur_h cur_pixels best_mode
    if [ -z "${max_res}" ] || ! echo "${max_res}" | grep -qE '^[0-9]+x[0-9]+$'; then
        max_res="1920x1080"
    fi
    max_w=$(echo "${max_res}" | cut -dx -f1)
    max_h=$(echo "${max_res}" | cut -dx -f2)
    max_pixels=$((max_w * max_h))

    cur_mode=$(_get_current_mode_string "${PSCREEN}")
    cur_res=$(echo "${cur_mode}" | cut -d'@' -f1)
    cur_w=$(echo "${cur_res}" | cut -dx -f1)
    cur_h=$(echo "${cur_res}" | cut -dx -f2)
    if echo "${cur_w}" | grep -qE '^[0-9]+$' && echo "${cur_h}" | grep -qE '^[0-9]+$'; then
        cur_pixels=$((cur_w * cur_h))
        if [ "${cur_pixels}" -le "${max_pixels}" ]; then
            return 0
        fi
    fi

    best_mode=$(_get_drm_modes "${PSCREEN}" | awk -F'[@x]' -v maxp="${max_pixels}" '
        {
            w = $1 + 0; h = $2 + 0; hz = $3 + 0
            area = w * h
            if (area <= maxp) {
                d = hz - 60; if (d < 0) d = -d
                score = area * 1e3 + (d <= 1) * 1e9 - d * 10
                if (best == "" || score > bscore) {
                    best = $0
                    bscore = score
                }
            }
        }
        END { print best }
    ')
    if [ -n "${best_mode}" ]; then
        _apply_gamescope_mode "${best_mode}"
    else
        _apply_gamescope_mode "${max_w}x${max_h}@60.000Hz"
    fi
}

if [ $# -eq 0 ]; then
    f_usage
    exit 1
fi

ACTION_PRECHECK=$1
case "${ACTION_PRECHECK}" in
    "getDisplayComp")
        echo "gamescope"
        exit 0
        ;;
    "getDisplayMode")
        echo "wayland"
        exit 0
        ;;
    "supportHdr")
        _hdr_capable
        exit $?
        ;;
    "setHdr")
        exit 0
        ;;
    "supportVrr")
        _vrr_capable
        exit $?
        ;;
    "setVrr")
        exit 0
        ;;
    "supportSystemRotation" | "supportSystemReflection")
        exit 1
        ;;
    "configureWindow" | "repositionOutputs")
        exit 0
        ;;
esac

PSCREEN_ARG=""
if [ "$1" = "--screen" ]; then
    shift
    PSCREEN_ARG="$1"
    shift
fi

if [ -n "${PSCREEN_ARG}" ]; then
    PSCREEN="${PSCREEN_ARG}"
else
    PSCREEN=$(_detect_primary_screen)
fi

ACTION=$1
shift

case "${ACTION}" in
    "listOutputs")
        _list_connected_outputs
        ;;
    "currentOutput")
        if [ -n "${PSCREEN}" ]; then
            echo "${PSCREEN}"
        else
            echo "unknown"
        fi
        ;;
    "setOutput")
        if [ -n "$1" ]; then
            echo "$1" > "${OUTPUT_FILE}"
        fi
        ;;
    "listModes")
        echo "max-1920x1080:maximum 1920x1080"
        echo "max-640x480:maximum 640x480"
        if [ -n "${PSCREEN}" ]; then
            _get_drm_modes "${PSCREEN}" | while IFS= read -r mode; do
                res=$(echo "${mode}" | cut -d'@' -f1)
                hz=$(echo "${mode}" | sed 's/.*@\([0-9.]*\)Hz/\1/')
                if [ -n "${res}" ] && [ -n "${hz}" ]; then
                    printf "%s.%s:%s %s Hz\n" "${res}" "$(_hz_to_mhz "${hz}")" "${res}" "${hz}"
                fi
            done
        fi
        ;;
    "setMode")
        MODE_TO_SET="$1"
        case "${MODE_TO_SET}" in
            max-*)
                f_minTomaxResolution "${MODE_TO_SET#max-}"
                ;;
            auto|"")
                pref=$(_get_preferred_drm_mode "${PSCREEN}")
                if [ -n "${pref}" ]; then
                    _apply_gamescope_mode "${pref}"
                fi
                ;;
            *)
                if echo "${MODE_TO_SET}" | grep -q '@'; then
                    res="${MODE_TO_SET%%@*}"
                    ref="${MODE_TO_SET#*@}"
                    ref="${ref%Hz}"
                else
                    res="${MODE_TO_SET%%.*}"
                    ref="${MODE_TO_SET#*.}"
                    if [ "${ref}" = "${MODE_TO_SET}" ]; then
                        ref=""
                    fi
                fi
                if [ -z "${ref}" ]; then
                    _apply_gamescope_mode "${res}@60.000Hz"
                else
                    hz=$(awk -v r="${ref}" 'BEGIN { want = (index(r, ".") || r < 1000) ? r + 0 : r / 1000; printf "%.3f\n", want }')
                    _apply_gamescope_mode "${res}@${hz}Hz"
                fi
                ;;
        esac
        ;;
    "currentMode")
        if [ -z "${PSCREEN}" ]; then
            echo "unknown.0"
            exit 1
        fi
        cur=$(_get_current_mode_string "${PSCREEN}")
        res=$(echo "${cur}" | cut -d'@' -f1)
        hz=$(echo "${cur}" | sed -n 's/.*@\([0-9.]*\)Hz/\1/p')
        if [ -n "${res}" ] && [ -n "${hz}" ]; then
            echo "${res}.$(_hz_to_mhz "${hz}")"
        elif [ -n "${res}" ]; then
            echo "${res}.0"
        else
            echo "unknown.0"
            exit 1
        fi
        ;;
    "currentResolution")
        if [ -z "${PSCREEN}" ]; then
            echo "1920x1080"
            exit 0
        fi
        cur=$(_get_current_mode_string "${PSCREEN}")
        echo "${cur}" | cut -d'@' -f1
        ;;
    "refreshRate")
        cur=$(_get_current_mode_string "${PSCREEN}")
        echo "${cur}" | sed -n 's/.*@\([0-9.]*\)Hz/\1/p'
        ;;
    "minTomaxResolution" | "minTomaxResolution-secure")
        f_minTomaxResolution "$1"
        ;;
    "getRotation")
        echo "0"
        ;;
    "setRotation")
        exit 0
        ;;
    "outputModel")
        if [ -n "${PSCREEN}" ]; then
            edid=$(ls /sys/class/drm/card*-"${PSCREEN}"/edid 2>/dev/null | head -n1)
            if [ -n "${edid}" ]; then
                edid-decode "${edid}" 2>/dev/null | sed -n 's/^[[:space:]]*Display Product Name:[[:space:]]*'\''\(.*\)'\''/\1/p' | head -n1 | sed 's/[^A-Za-z0-9]/_/g'
            fi
        fi
        ;;
    *)
        f_usage
        exit 1
        ;;
esac

exit 0
