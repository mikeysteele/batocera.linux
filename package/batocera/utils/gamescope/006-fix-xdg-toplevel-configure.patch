+	if ( event->state == WL_KEYBOARD_KEY_STATE_PRESSED && keysym == XKB_KEY_F4 && ( wlr_keyboard_get_modifiers( keyboard ) & WLR_MODIFIER_ALT ) )
+	{
+		if ( wlserver.kb_focus_surface )
